# 로컬 개발용 — 이 파일을 .env.local로 복사해 값을 채운다 (.env*는 gitignore 대상)

# GitHub API 토큰 (쓰기: 할 일 이슈 생성). 미설정 시 GitHub 연동 비활성
GITHUB_TOKEN=

# Judge Mode 읽기 전용 토큰. 미설정 시 GITHUB_TOKEN으로 폴백
JUDGE_GITHUB_TOKEN=

# 기본 연결 저장소 (owner/repo)
FIRST_MOVE_REPO=JungSeunghun/matdaton

# ICS 일정 URL (선택)
FIRST_MOVE_ICS_URL=

# 승인 토큰 서명 시크릿. 미설정 시 개발용 기본값 사용 (경고 로그 출력)
FIRST_MOVE_HMAC_SECRET=

# 승인 토큰 TTL(초), 기본 600
APPROVAL_TTL_SECONDS=

# Cosmos DB — 미설정 시 인메모리 스토어 사용 (로컬 개발 기본)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=firstmove

# Foundry 추론 — 미설정 시 결정적 mock 계약 사용
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=gpt-4o

# Application Insights — 미설정 시 텔레메트리 no-op
APPLICATIONINSIGHTS_CONNECTION_STRING=
