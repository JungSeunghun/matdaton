{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "hmacSecret": {
      "value": "${FIRST_MOVE_HMAC_SECRET}"
    },
    "githubToken": {
      "value": "${GITHUB_TOKEN=}"
    },
    "judgeGithubToken": {
      "value": "${JUDGE_GITHUB_TOKEN=}"
    },
    "firstMoveRepo": {
      "value": "${FIRST_MOVE_REPO=}"
    },
    "firstMoveIcsUrl": {
      "value": "${FIRST_MOVE_ICS_URL=}"
    },
    "foundryLocation": {
      "value": "${FOUNDRY_LOCATION=eastus2}"
    },
    "foundryModelName": {
      "value": "${FOUNDRY_MODEL_NAME=gpt-4o}"
    },
    "foundryModelVersion": {
      "value": "${FOUNDRY_MODEL_VERSION=2024-11-20}"
    }
  }
}
